        <mxCell id="EBPA-UC0ZaJjVb8i-U-C-5" parent="EBPA-UC0ZaJjVb8i-U-C-34" style="ellipse;whiteSpace=wrap;html=1;shapeInside=1;fontSize=8;spacing=10;" value="&lt;div style=&quot;line-height: 80%;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;How do I get my entities to do things?&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 80%;&quot;&gt;&lt;font style=&quot;line-height: 80%; font-size: 3px;&quot;&gt;each entity needs to be able to simulate behaviour so it&#39;s not just a static lump of pixels.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 80%;&quot;&gt;&lt;font style=&quot;line-height: 80%; font-size: 3px;&quot;&gt;Each type of entity might have different behaviour to simulate.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;line-height: 80%;&quot;&gt;&lt;font style=&quot;line-height: 80%; font-size: 3px;&quot;&gt;How can I get each entity type to behave differently?&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="105" x="17.5" y="85" as="geometry" />
        </mxCell>
